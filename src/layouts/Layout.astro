---
import '../styles/global.css';

const { title = "Saeed Babaee | Computational Engineer", description = "Personal Website & Portfolio of Saeed Babaee" } = Astro.props;
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { name: 'Projects', href: '/projects' },
  { name: 'Research', href: '/research' },
  { name: 'Services', href: '/services' },
  { name: 'Blog', href: '/blog' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' },
];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
      if (theme === 'dark') document.documentElement.classList.add('dark');
    </script>
  </head>

  <body class="bg-background text-foreground min-h-screen flex flex-col font-sans antialiased">
    <header class="sticky top-0 z-50 w-full border-b border-border/60 bg-background/80 backdrop-blur-md">
      <div class="max-w-5xl mx-auto flex h-14 items-center justify-between px-4 sm:px-6 gap-4">
        
        <!-- Logo -->
        <a href="/" class="text-lg font-bold tracking-tight shrink-0 hover:opacity-80 transition-opacity">
          Saeed<span class="text-primary">.</span>
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden lg:flex items-center gap-4 text-sm font-medium">
          {navItems.map((item) => {
            const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`transition-colors hover:text-foreground whitespace-nowrap ${
                  isActive ? 'text-foreground font-semibold' : 'text-muted-foreground'
                }`}
              >
                {item.name}
              </a>
            );
          })}
        </nav>

        <!-- Right side: Search + Theme + Mobile menu -->
        <div class="flex items-center gap-2 shrink-0">
          
          <!-- Search (always visible on desktop) -->
          <div class="relative hidden sm:block">
            <input
              type="search"
              id="site-search"
              placeholder="Search..."
              class="h-8 w-28 md:w-36 rounded-md border border-input bg-background px-3 pl-8 text-xs 
                     placeholder:text-muted-foreground focus-visible:outline-none 
                     focus-visible:ring-1 focus-visible:ring-ring transition-all focus:w-44"
            />
            <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-muted-foreground pointer-events-none" 
                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>

          <!-- Theme Toggle -->
          <button
            id="theme-toggle"
            type="button"
            class="rounded-md p-2 text-muted-foreground hover:bg-accent hover:text-foreground transition-colors border border-border/40"
            aria-label="Toggle theme"
          >
            <span id="theme-icon" class="text-sm">🌙</span>
          </button>

          <!-- Mobile Menu Button -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="lg:hidden rounded-md p-2 text-muted-foreground hover:bg-accent border border-border/40"
            aria-label="Toggle Menu"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile / Tablet Menu -->
      <div id="mobile-menu" class="hidden lg:hidden border-b border-border bg-background px-4 py-3 space-y-1">
        {navItems.map((item) => {
          const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`block py-2.5 text-sm font-medium transition-colors ${
                isActive ? 'text-foreground font-semibold' : 'text-muted-foreground hover:text-foreground'
              }`}
            >
              {item.name}
            </a>
          );
        })}

        <!-- Mobile Search -->
        <div class="relative pt-2 sm:hidden">
          <input
            type="search"
            id="site-search-mobile"
            placeholder="Search..."
            class="h-9 w-full rounded-md border border-input bg-background px-3 pl-9 text-sm 
                   placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
          />
          <svg class="absolute left-3 top-[calc(50%+4px)] -translate-y-1/2 h-4 w-4 text-muted-foreground pointer-events-none" 
               fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
    </header>

    <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>

    <footer class="border-t border-border/60 py-6">
      <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 px-4 sm:px-6 text-xs text-muted-foreground">
        <p>© {new Date().getFullYear()} Saeed Babaee. All rights reserved.</p>
        <div class="flex gap-4">
          <a href="https://github.com/msaeedbabaee" target="_blank" class="hover:text-foreground transition-colors">GitHub</a>
          <a href="https://linkedin.com/in/msaeedbabaee" target="_blank" class="hover:text-foreground transition-colors">LinkedIn</a>
        </div>
      </div>
    </footer>

    <script>
      // Theme
      function setupTheme(btnId, iconId) {
        const btn = document.getElementById(btnId);
        const icon = document.getElementById(iconId);
        const update = () => {
          const dark = document.documentElement.classList.contains('dark');
          if (icon) icon.textContent = dark ? '☀️' : '🌙';
        };
        update();
        btn?.addEventListener('click', () => {
          const dark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', dark ? 'dark' : 'light');
          update();
        });
      }
      setupTheme('theme-toggle', 'theme-icon');

      // Mobile menu
      document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
        document.getElementById('mobile-menu')?.classList.toggle('hidden');
      });

      // ========== Search ==========
      function setupSearch(inputId) {
        const input = document.getElementById(inputId);
        if (!input) return;

        // لیست صفحات + کلمات کلیدی مرتبط
        const pages = [
          {
            title: 'Projects',
            url: '/projects',
            keys: ['project', 'projects', 'slope', 'stability', 'plaxis', 'tool', 'assessment', 'fem', 'analysis']
          },
          {
            title: 'Research',
            url: '/research',
            keys: ['research', 'publication', 'paper', 'pinn', 'neural', 'geomechanic', 'physics', 'informed']
          },
          {
            title: 'Services',
            url: '/services',
            keys: ['service', 'services', 'consult', 'consulting', 'ai', 'ml', 'software', 'modeling', 'freelance']
          },
          {
            title: 'Blog',
            url: '/blog',
            keys: ['blog', 'article', 'post', 'python', 'astro', 'tutorial', 'guide']
          },
          {
            title: 'About',
            url: '/about',
            keys: ['about', 'me', 'education', 'experience', 'skill', 'bio', 'background']
          },
          {
            title: 'Contact',
            url: '/contact',
            keys: ['contact', 'email', 'message', 'touch', 'reach', 'hire']
          },
        ];

        input.addEventListener('keydown', (e) => {
          if (e.key !== 'Enter') return;

          const q = input.value.trim().toLowerCase();
          if (!q) return;

          // پیدا کردن بهترین تطبیق
          let best = null;
          let bestScore = 0;

          for (const page of pages) {
            let score = 0;
            for (const key of page.keys) {
              if (key === q) score += 10;           // تطبیق کامل
              else if (key.startsWith(q)) score += 5;
              else if (key.includes(q)) score += 2;
              else if (q.includes(key)) score += 1;
            }
            // تطبیق با عنوان صفحه
            if (page.title.toLowerCase().includes(q)) score += 8;

            if (score > bestScore) {
              bestScore = score;
              best = page;
            }
          }

          if (best && bestScore > 0) {
            window.location.href = best.url;
          } else {
            // اگر چیزی پیدا نشد → صفحه پروژه‌ها
            window.location.href = '/projects';
          }
        });
      }

      setupSearch('site-search');
      setupSearch('site-search-mobile');
    </script>
  </body>
</html>
