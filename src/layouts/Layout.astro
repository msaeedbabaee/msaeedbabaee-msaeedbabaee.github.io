---
interface Props {
  title?: string;
}

const { title = "Saeed Babaee | Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css" />
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col font-sans">
    <header class="border-b bg-white sticky top-0 z-50">
      <nav class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-bold text-lg hover:text-blue-600 transition-colors">
          Saeed Babaee
        </a>
        <div class="flex gap-6 text-sm font-medium text-slate-600">
          <a href="/projects" class="hover:text-blue-600 transition-colors">Projects</a>
          <a href="/services" class="hover:text-blue-600 transition-colors">Services</a>
          <a href="/research" class="hover:text-blue-600 transition-colors">Research</a>
          <a href="/about" class="hover:text-blue-600 transition-colors">About</a>
        </div>
      </nav>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-10 flex-grow w-full">
      <slot />
    </main>

    <footer class="border-t bg-white py-6 text-center text-xs text-slate-500">
      © {new Date().getFullYear()} Saeed Babaee. All rights reserved.
    </footer>
  </body>
</html>