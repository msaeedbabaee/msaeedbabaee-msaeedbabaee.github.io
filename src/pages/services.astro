---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services | Saeed Babaee">
  <div class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl font-extrabold tracking-tight text-foreground">Services</h1>
      <p class="text-sm text-muted-foreground">Engineering consulting and computational AI solutions.</p>
    </div>

    <div class="h-[1px] w-full bg-border"></div>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="rounded-lg border border-border bg-card p-6 space-y-3 shadow-sm hover:border-foreground/20 transition-all">
        <h2 class="text-lg font-bold text-card-foreground">AI & ML Solutions</h2>
        <p class="text-sm text-muted-foreground leading-relaxed">Developing physics-informed neural networks and surrogate models for complex physical systems.</p>
      </div>

      <div class="rounded-lg border border-border bg-card p-6 space-y-3 shadow-sm hover:border-foreground/20 transition-all">
        <h2 class="text-lg font-bold text-card-foreground">Geotechnical Analysis</h2>
        <p class="text-sm text-muted-foreground leading-relaxed">Advanced finite element modeling (FEA) and reliability assessment for slope stability.</p>
      </div>

      <div class="rounded-lg border border-border bg-card p-6 space-y-3 shadow-sm hover:border-foreground/20 transition-all">
        <h2 class="text-lg font-bold text-card-foreground">Automation Scripts</h2>
        <p class="text-sm text-muted-foreground leading-relaxed">Custom Python tooling to automate complex engineering simulations and data post-processing.</p>
      </div>
    </div>
  </div>
</Layout>