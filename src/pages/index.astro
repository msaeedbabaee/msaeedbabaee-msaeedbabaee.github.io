---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<Layout title="Projects | Saeed Babaee">
  <div class="space-y-8">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-foreground">Projects</h1>
      <p class="text-muted-foreground mt-2">A showcase of computational engineering, machine learning, and numerical modeling work.</p>
    </div>

    {projects.length === 0 ? (
      <div class="rounded-lg border border-border p-8 text-center text-muted-foreground">
        No projects found.
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2">
        {projects.map((project) => (
          <a
            href={`/projects/${project.id}`}
            class="group block rounded-lg border border-border bg-card p-6 shadow-sm hover:border-foreground/30 transition-all"
          >
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono text-muted-foreground uppercase">{project.data.category || 'Geotechnical AI'}</span>
              {project.data.date && (
                <span class="text-xs text-muted-foreground font-mono">{project.data.date}</span>
              )}
            </div>
            <h2 class="text-xl font-bold text-card-foreground group-hover:text-primary transition-colors">
              {project.data.title}
            </h2>
            <p class="text-sm text-muted-foreground mt-2 leading-relaxed">
              {project.data.description}
            </p>
            {project.data.tags && (
              <div class="flex flex-wrap gap-1.5 mt-4">
                {project.data.tags.map((tag: string) => (
                  <span class="rounded bg-secondary px-2 py-0.5 text-xs text-secondary-foreground font-mono">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>