---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SAEED BABAEE | Geotechnical Engineer & AI Specialist">
  <section class="py-12 space-y-8">
    <div class="space-y-4">
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
        Saeed Babaee
      </h1>
      <p class="text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl font-normal">
        Geotechnical Engineer & AI / Software Specialist
      </p>
    </div>

    <div class="h-[1px] w-full bg-zinc-200 dark:bg-zinc-800"></div>

    <div class="space-y-4">
      <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">
        Bio & Background
      </h2>
      <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-3xl">
        I specialize at the intersection of geotechnical engineering, machine learning, and software development. My focus centers on building computational models, physics-informed AI frameworks, and automated analysis tools for complex geotechnical systems.
      </p>
    </div>

    <div class="pt-4">
      <a href="/projects" class="inline-flex items-center px-5 py-2.5 rounded-lg bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 font-semibold text-sm hover:opacity-90 transition-opacity">
        Explore Projects →
      </a>
    </div>
  </section>
</Layout>