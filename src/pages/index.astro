---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home | Saeed Babaee">
  <div class="max-w-3xl mx-auto py-12 text-center">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">
      Welcome to My Website
    </h1>
    <p class="text-lg text-gray-600 mb-8">
      Explore my projects, research papers, and technical notes.
    </p>
    <div class="flex justify-center gap-4">
      <a 
        href="/projects" 
        class="px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition"
      >
        View Projects
      </a>
    </div>
  </div>
</Layout>