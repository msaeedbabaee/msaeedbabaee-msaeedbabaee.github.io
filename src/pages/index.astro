---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<Layout title="Projects | Saeed Babaee">
  <div class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl font-extrabold tracking-tight text-foreground">Projects</h1>
      <p class="text-sm text-muted-foreground">Selected engineering and computational research projects.</p>
    </div>

    <div class="h-[1px] w-full bg-border"></div>

    <div class="grid gap-4 sm:grid-cols-2">
      {projects.map((project) => (
        <a 
          href={`/projects/${project.id}`} 
          class="block p-5 rounded-lg border border-border bg-card shadow-sm hover:shadow-md transition-all hover:border-foreground/20 group"
        >
          <h2 class="text-lg font-bold text-card-foreground group-hover:text-primary transition-colors mb-2">
            {project.data.title}
          </h2>
          <p class="text-sm text-muted-foreground line-clamp-3 mb-4 leading-relaxed">
            {project.data.description}
          </p>
          {project.data.tags && (
            <div class="flex flex-wrap gap-1.5">
              {project.data.tags.map((tag: string) => (
                <span class="inline-flex items-center rounded-md bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground border border-border/50">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </div>
</Layout>