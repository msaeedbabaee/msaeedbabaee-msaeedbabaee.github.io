---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home | Portfolio" description="Showcase of projects and research">
  <!-- Hero Section -->
  <section class="space-y-6 pb-8 pt-6 md:pb-12 md:pt-10 lg:py-32">
    <div class="container mx-auto flex max-w-[64rem] flex-col items-center gap-4 text-center px-4">
      <span class="rounded-2xl bg-muted px-4 py-1.5 text-sm font-medium">Portfolio & Resume</span>
      <h1 class="font-bold text-3xl sm:text-5xl md:text-6xl lg:text-7xl tracking-tight">
        Developer & Researcher
      </h1>
      <p class="max-w-[42rem] leading-normal text-muted-foreground sm:text-xl sm:leading-8">
        Building intelligent systems, numerical modeling, and modern web applications with high engineering standards.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/projects" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-8 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90">
          View Projects
        </a>
        <a href="/contact" class="inline-flex h-11 items-center justify-center rounded-md border border-input bg-background px-8 text-sm font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground">
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="container mx-auto max-w-screen-xl px-4 py-12 space-y-8">
    <div class="flex flex-col items-start gap-2">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Featured Projects</h2>
      <p class="text-muted-foreground">Highlights of recent work and implementations.</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Card 1 -->
      <div class="rounded-lg border bg-card text-card-foreground shadow-sm transition-all hover:shadow-md flex flex-col justify-between">
        <div class="p-6 space-y-2">
          <h3 class="text-lg font-semibold tracking-tight">Slope Stability Analysis</h3>
          <p class="text-sm text-muted-foreground">A deep learning approach for geotechnical safety evaluation.</p>
        </div>
        <div class="p-6 pt-0 flex items-center gap-2">
          <span class="inline-flex items-center rounded-md bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground">Python</span>
          <span class="inline-flex items-center rounded-md bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground">PyTorch</span>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="rounded-lg border bg-card text-card-foreground shadow-sm transition-all hover:shadow-md flex flex-col justify-between">
        <div class="p-6 space-y-2">
          <h3 class="text-lg font-semibold tracking-tight">Modern Web Portfolio</h3>
          <p class="text-sm text-muted-foreground">Performant frontend architecture styled with shadcn/ui.</p>
        </div>
        <div class="p-6 pt-0 flex items-center gap-2">
          <span class="inline-flex items-center rounded-md bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground">Astro</span>
          <span class="inline-flex items-center rounded-md bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground">Tailwind</span>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="rounded-lg border bg-card text-card-foreground shadow-sm transition-all hover:shadow-md flex flex-col justify-between">
        <div class="p-6 space-y-2">
          <h3 class="text-lg font-semibold tracking-tight">PINN in Geomechanics</h3>
          <p class="text-sm text-muted-foreground">Physics-Informed Neural Networks for complex field simulations.</p>
        </div>
        <div class="p-6 pt-0 flex items-center gap-2">
          <span class="inline-flex items-center rounded-md bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground">Deep Learning</span>
        </div>
      </div>
    </div>
  </section>
</Layout>