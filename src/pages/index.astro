---
---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');

// Extract all unique tags across projects
const allTags = [...new Set(projects.flatMap((p) => p.data.tags || []))].sort();
---

<Layout title="Projects | Saeed Babaee">
  <div class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl font-bold tracking-tight">Projects</h1>
      <p class="text-muted-foreground">
        Open-source tools, research projects, and computational engineering applications.
      </p>
    </div>

    <!-- Tag Filters -->
    {allTags.length > 0 && (
      <div class="flex flex-wrap items-center gap-2">
        <button
          data-tag="all"
          class="filter-btn active inline-flex items-center rounded-md border border-primary bg-primary px-3 py-1 text-xs font-medium text-primary-foreground transition-colors"
        >
          All
        </button>
        {allTags.map((tag) => (
          <button
            data-tag={tag}
            class="filter-btn inline-flex items-center rounded-md border border-border bg-background px-3 py-1 text-xs font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
          >
            {tag}
          </button>
        ))}
      </div>
    )}

    <!-- Projects Grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="projects-grid">
      {projects.map((project) => (
        <a
          href={`/projects/${project.id}`}
          data-tags={(project.data.tags || []).join(',')}
          class="project-card group block overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-all duration-200 hover:shadow-md hover:border-primary/40 hover:-translate-y-0.5"
        >
          <!-- عکس فقط اگر وجود داشته باشد -->
          {project.data.image && (
            <div class="aspect-video w-full overflow-hidden bg-muted">
              <img
                src={project.data.image}
                alt={project.data.title}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            </div>
          )}

          <div class="p-5">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-medium text-muted-foreground uppercase tracking-wide">
                {project.data.category || 'Project'}
              </span>
              {project.data.year && (
                <span class="text-xs text-muted-foreground">{project.data.year}</span>
              )}
            </div>

            <h2 class="text-lg font-semibold text-card-foreground group-hover:text-primary transition-colors">
              {project.data.title}
            </h2>

            <p class="text-sm text-muted-foreground mt-2 line-clamp-3 leading-relaxed">
              {project.data.description}
            </p>

            {project.data.tags && (
              <div class="flex flex-wrap gap-1.5 mt-4 pt-3 border-t border-border/50">
                {project.data.tags.map((tag) => (
                  <span class="rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground transition-colors group-hover:bg-primary/10 group-hover:text-primary">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>

    <p id="no-results" class="hidden text-center text-sm text-muted-foreground py-8">
      No projects found for this tag.
    </p>
  </div>

  <script>
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.project-card');
    const noResults = document.getElementById('no-results');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedTag = btn.getAttribute('data-tag');

        buttons.forEach((b) => {
          b.classList.remove('bg-primary', 'text-primary-foreground', 'border-primary', 'active');
          b.classList.add('bg-background', 'text-muted-foreground', 'border-border');
        });
        btn.classList.add('bg-primary', 'text-primary-foreground', 'border-primary', 'active');
        btn.classList.remove('bg-background', 'text-muted-foreground', 'border-border');

        let visible = 0;
        cards.forEach((card) => {
          const cardTags = (card.getAttribute('data-tags') || '').split(',');
          const show = selectedTag === 'all' || cardTags.includes(selectedTag);
          card.classList.toggle('hidden', !show);
          if (show) visible++;
        });

        noResults?.classList.toggle('hidden', visible > 0);
      });
    });
  </script>
</Layout>
