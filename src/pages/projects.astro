---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: "AI Slope Stability Analysis",
    category: "Machine Learning / Geotechnical",
    description: "A machine learning framework for geotechnical slope stability analysis using deep surrogate models.",
    tags: ["Python", "PyTorch", "PLAXIS 3D"],
    slug: "ai-slope"
  }
];
---

<Layout title="Projects | Saeed Babaee">
  <div class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl font-extrabold tracking-tight text-foreground">Projects</h1>
      <p class="text-sm text-muted-foreground">
        A collection of computational engineering and machine learning projects.
      </p>
    </div>

    <div class="h-[1px] w-full bg-border"></div>

    <div class="space-y-4">
      {projects.map((project) => (
        <div class="rounded-lg border border-border bg-card p-6 space-y-4 shadow-sm hover:border-accent-foreground/20 transition-colors">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <h2 class="text-xl font-bold tracking-tight text-card-foreground hover:text-muted-foreground cursor-pointer transition-colors">
              {project.title}
            </h2>
          </div>

          <p class="text-xs text-muted-foreground leading-relaxed">{project.description}</p>

          <div class="flex flex-wrap gap-1.5 pt-2">
            {project.tags.map((tag) => (
              <span class="inline-flex items-center rounded-md border border-border bg-secondary px-2.5 py-0.5 text-[11px] font-mono font-medium text-secondary-foreground">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>