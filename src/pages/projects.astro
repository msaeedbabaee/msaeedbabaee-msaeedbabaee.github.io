---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<Layout title="Projects | Saeed Babaee">
  <div class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl font-extrabold tracking-tight text-foreground">Projects</h1>
      <p class="text-sm text-muted-foreground">
        A collection of computational engineering and machine learning projects.
      </p>
    </div>

    <div class="h-[1px] w-full bg-border"></div>

    <div class="grid gap-4">
      {projects.map((project) => (
        <a 
          href={`/projects/${project.id}`} 
          class="group block rounded-lg border border-border bg-card p-6 text-card-foreground shadow-sm transition-all hover:border-foreground/20"
        >
          <div class="space-y-3">
            <h2 class="text-xl font-bold tracking-tight text-card-foreground group-hover:text-primary transition-colors">
              {project.data.title}
            </h2>

            <p class="text-sm text-muted-foreground leading-relaxed">
              {project.data.description}
            </p>

            <div class="flex flex-wrap gap-2 pt-2">
              {project.data.tags?.map((tag) => (
                <span class="inline-flex items-center rounded-md border border-border bg-secondary px-2.5 py-0.5 text-xs font-mono text-secondary-foreground">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>