---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

const allCategories = [...new Set(posts.map((p) => p.data.category || 'Technical'))].sort();
---

<Layout title="Blog | Saeed Babaee">
  <div class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl font-bold tracking-tight">Blog</h1>
      <p class="text-muted-foreground">
        Technical notes, research insights, and personal reflections on computational engineering and AI.
      </p>
    </div>

    <!-- Category Filters -->
    {allCategories.length > 1 && (
      <div class="flex flex-wrap items-center gap-2">
        <button
          data-cat="all"
          class="filter-btn active inline-flex items-center rounded-md border border-primary bg-primary px-3 py-1 text-xs font-medium text-primary-foreground transition-colors"
        >
          All
        </button>
        {allCategories.map((cat) => (
          <button
            data-cat={cat}
            class="filter-btn inline-flex items-center rounded-md border border-border bg-background px-3 py-1 text-xs font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
          >
            {cat}
          </button>
        ))}
      </div>
    )}

    <!-- Posts -->
    <div class="space-y-4" id="posts-list">
      {posts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          data-cat={post.data.category || 'Technical'}
          class="post-card group block overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-all duration-200 hover:shadow-md hover:border-primary/40 hover:-translate-y-0.5"
        >
          <!-- عکس فقط اگر وجود داشته باشد -->
          {post.data.image && (
            <div class="aspect-[21/9] w-full overflow-hidden bg-muted">
              <img
                src={post.data.image}
                alt={post.data.title}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            </div>
          )}

          <div class="p-5">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="rounded-md bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground">
                {post.data.category}
              </span>
              <span class="text-xs text-muted-foreground">
                {new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
              </span>
            </div>

            <h2 class="text-lg font-semibold text-card-foreground group-hover:text-primary transition-colors">
              {post.data.title}
            </h2>

            <p class="text-sm text-muted-foreground mt-2 leading-relaxed">
              {post.data.description}
            </p>

            <div class="mt-4 pt-3 border-t border-border/50 flex justify-between items-center">
              <span class="text-sm text-muted-foreground">Read article</span>
              <span class="text-sm font-medium text-primary opacity-0 group-hover:opacity-100 transition-opacity">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <p id="no-results" class="hidden text-center text-sm text-muted-foreground py-8">
      No posts in this category.
    </p>
  </div>

  <script>
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.post-card');
    const noResults = document.getElementById('no-results');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-cat');

        buttons.forEach((b) => {
          b.classList.remove('bg-primary', 'text-primary-foreground', 'border-primary', 'active');
          b.classList.add('bg-background', 'text-muted-foreground', 'border-border');
        });
        btn.classList.add('bg-primary', 'text-primary-foreground', 'border-primary', 'active');
        btn.classList.remove('bg-background', 'text-muted-foreground', 'border-border');

        let visible = 0;
        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-cat');
          const show = cat === 'all' || cardCat === cat;
          card.classList.toggle('hidden', !show);
          if (show) visible++;
        });

        noResults?.classList.toggle('hidden', visible > 0);
      });
    });
  </script>
</Layout>
