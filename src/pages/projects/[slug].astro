---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} | Saeed Babaee`}>
  <article class="space-y-8">
    <div class="space-y-3">
      <a href="/projects" class="text-xs text-muted-foreground hover:text-foreground transition-colors">
        ← Back to Projects
      </a>
      <h1 class="text-3xl font-extrabold tracking-tight text-foreground">{project.data.title}</h1>
      <p class="text-sm text-muted-foreground">{project.data.description}</p>
    </div>

    <div class="h-[1px] w-full bg-border"></div>

    <div class="prose prose-neutral dark:prose-invert max-w-none text-foreground">
      <Content />
    </div>
  </article>
</Layout>