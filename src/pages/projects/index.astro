---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const projects = await getCollection('projects');
---

<Layout title="پروژه‌ها | پرتفولیو" description="فهرست کامل پروژه‌ها و نمونه‌کارها">
  <div class="container mx-auto max-w-screen-xl px-4 py-10 md:py-16 space-y-8">
    <!-- Header Section -->
    <div class="flex flex-col items-start gap-2 border-b border-border/40 pb-8">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">پروژه‌ها</h1>
      <p class="text-muted-foreground text-lg">
        مجموعه فعالیت‌ها، ابزارها و نمونه‌کارهای اجرا شده.
      </p>
    </div>

    <!-- Grid Projects -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <article class="group relative rounded-lg border bg-card text-card-foreground shadow-sm transition-all hover:shadow-md flex flex-col justify-between">
          <div class="p-6 space-y-3">
            <h2 class="text-xl font-semibold tracking-tight group-hover:text-primary transition-colors">
              <a href={`/projects/${project.id}`} class="after:absolute after:inset-0">
                {project.data.title}
              </a>
            </h2>
            <p class="text-sm text-muted-foreground leading-relaxed line-clamp-3">
              {project.data.description}
            </p>
          </div>
          <div class="p-6 pt-0 flex flex-wrap gap-1.5 z-10">
            {project.data.tags?.map((tag: string) => (
              <span class="inline-flex items-center rounded-md bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground transition-colors hover:bg-secondary/80">
                {tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>