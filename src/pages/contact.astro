---
import Layout from '../layouts/Layout.astro';

const contactLinks = [
  {
    name: "Email",
    value: "saeed.babaee@example.com",
    href: "mailto:saeed.babaee@example.com",
    icon: "📧"
  },
  {
    name: "GitHub",
    value: "github.com/msaeedbabaee",
    href: "https://github.com/msaeedbabaee",
    icon: "💻"
  },
  {
    name: "LinkedIn",
    value: "linkedin.com/in/msaeedbabaee",
    href: "https://linkedin.com",
    icon: "🔗"
  },
  {
    name: "Google Scholar",
    value: "Saeed Babaee Profile",
    href: "https://scholar.google.com",
    icon: "🎓"
  }
];
---

<Layout title="Contact | Saeed Babaee">
  <section class="py-8 max-w-3xl mx-auto space-y-8">
    <div>
      <h1 class="text-3xl font-bold mb-2">Get in Touch</h1>
      <p class="text-slate-600">
        Feel free to reach out for research collaborations, engineering consultation, or project inquiries.
      </p>
    </div>

    <!-- Contact Cards Grid -->
    <div class="grid sm:grid-cols-2 gap-4">
      {contactLinks.map((item) => (
        <a 
          href={item.href} 
          target="_blank" 
          rel="noopener noreferrer"
          class="border rounded-xl p-5 bg-white hover:border-blue-500 hover:shadow-md transition-all flex items-center gap-4 group"
        >
          <span class="text-2xl bg-slate-100 p-3 rounded-lg group-hover:bg-blue-50 transition-colors">
            {item.icon}
          </span>
          <div>
            <div class="text-xs text-slate-500 font-semibold uppercase tracking-wider">{item.name}</div>
            <div class="text-slate-900 font-medium group-hover:text-blue-600 transition-colors">{item.value}</div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>