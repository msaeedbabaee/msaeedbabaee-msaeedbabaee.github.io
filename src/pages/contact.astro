---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Saeed Babaee">
  <div class="max-w-2xl mx-auto space-y-8">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-foreground">Get in Touch</h1>
      <p class="text-muted-foreground mt-2">Have a question or want to collaborate on research? Drop a message below.</p>
    </div>

    <form class="space-y-4 rounded-xl border border-border p-6 bg-card">
      <div class="space-y-2">
        <label class="text-sm font-medium text-foreground">Name</label>
        <input type="text" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Your name" />
      </div>

      <div class="space-y-2">
        <label class="text-sm font-medium text-foreground">Email</label>
        <input type="email" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" placeholder="your@email.com" />
      </div>

      <div class="space-y-2">
        <label class="text-sm font-medium text-foreground">Message</label>
        <textarea rows="4" class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary" placeholder="Your message..."></textarea>
      </div>

      <button
        type="submit"
        class="w-full rounded-xl bg-primary px-4 py-2.5 text-sm font-medium text-primary-foreground hover:bg-primary/90 transition-all shadow-sm"
      >
        Send Message
      </button>
    </form>
  </div>
</Layout>