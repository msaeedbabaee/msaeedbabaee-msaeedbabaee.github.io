---
import Layout from '../layouts/Layout.astro';

const skills = [
  "Python / PyTorch", "TensorFlow", "PLAXIS 2D/3D", "Geotechnical FEA",
  "TypeScript", "Astro", "Tailwind CSS", "FastAPI", "Git / CI/CD"
];
---

<Layout title="About | Saeed Babaee">
  <div class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl font-extrabold tracking-tight">About Me</h1>
      <p class="text-sm text-muted-foreground">
        Background, core competencies, and computational research background.
      </p>
    </div>

    <div class="h-[1px] w-full bg-border"></div>

    <div class="rounded-lg border border-border bg-card p-6 space-y-4 shadow-sm">
      <h2 class="text-lg font-bold tracking-tight">Biography</h2>
      <p class="text-xs text-muted-foreground leading-relaxed space-y-2">
        I am a Geotechnical Engineer and AI Specialist focused on merging physics-based numerical modeling with modern machine learning paradigms. My work bridges the gap between traditional geotechnical soil-structure interaction and scalable algorithmic solutions.
      </p>
    </div>

    <div class="rounded-lg border border-border bg-card p-6 space-y-4 shadow-sm">
      <h2 class="text-lg font-bold tracking-tight">Technical Stack & Skills</h2>
      <div class="flex flex-wrap gap-2">
        {skills.map((skill) => (
          <span class="inline-flex items-center rounded-md border border-border bg-secondary px-3 py-1 text-xs font-medium text-secondary-foreground">
            {skill}
          </span>
        ))}
      </div>
    </div>
  </div>
</Layout>