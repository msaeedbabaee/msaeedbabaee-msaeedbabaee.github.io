---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | Saeed Babaee">
  <div class="space-y-12 max-w-4xl mx-auto">
    <!-- Bio Header -->
    <section class="flex flex-col sm:flex-row items-center sm:items-start gap-6 pt-2">
      <img
        src="/assets/images/profile.jpg"
        alt="Saeed Babaee"
        onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=Saeed+Babaee&size=200&background=020617&color=fff';"
        class="w-32 h-32 sm:w-36 sm:h-36 rounded-2xl object-cover border border-border shadow-sm shrink-0 bg-muted"
      />
      <div class="space-y-3 text-center sm:text-left">
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">About Me</h1>
        <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
          I am a Computational Engineer and AI Researcher dedicated to bridging numerical modeling in geotechnical engineering with modern machine learning methodologies.
        </p>
      </div>
    </section>

    <!-- Education -->
    <section class="space-y-6">
      <h2 class="text-xl font-bold tracking-tight text-foreground border-b border-border pb-2">
        Education
      </h2>
      
      <div class="space-y-6 pl-4 border-l-2 border-border">
        <div class="relative space-y-1">
          <div class="absolute -left-[21px] top-1.5 h-2.5 w-2.5 rounded-full bg-primary"></div>
          <div class="flex items-center justify-between text-xs font-mono text-muted-foreground">
            <span>M.Sc. in Geotechnical Engineering</span>
            <span>University of Tehran</span>
          </div>
          <h3 class="text-base font-semibold text-foreground">Advanced Geomechanical Modeling & AI</h3>
        </div>

        <div class="relative space-y-1">
          <div class="absolute -left-[21px] top-1.5 h-2.5 w-2.5 rounded-full bg-muted-foreground/40"></div>
          <div class="flex items-center justify-between text-xs font-mono text-muted-foreground">
            <span>B.Sc. in Civil Engineering</span>
            <span>Completed</span>
          </div>
          <h3 class="text-base font-semibold text-foreground">Civil Engineering Department</h3>
        </div>
      </div>
    </section>

    <!-- Specializations -->
    <section class="space-y-6">
      <h2 class="text-xl font-bold tracking-tight text-foreground border-b border-border pb-2">
        Core Specializations
      </h2>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-border bg-card p-5 space-y-2 hover:border-primary/40 transition-colors">
          <h3 class="font-bold text-card-foreground">Machine Learning & Physics-Informed AI</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Developing surrogate models and physics-informed neural networks (PINNs) to accelerate complex geotechnical simulations.
          </p>
        </div>

        <div class="rounded-xl border border-border bg-card p-5 space-y-2 hover:border-primary/40 transition-colors">
          <h3 class="font-bold text-card-foreground">Numerical Modeling & Automation</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Automating PLAXIS 2D/3D and numerical workflows using Python scripting for large-scale parametric studies.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>