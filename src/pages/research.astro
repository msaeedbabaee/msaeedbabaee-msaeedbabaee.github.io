---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const researchPapers = await getCollection('research');
---

<Layout title="Research | Saeed Babaee">
  <div class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl font-extrabold tracking-tight text-foreground">Research & Publications</h1>
      <p class="text-sm text-muted-foreground">
        Academic papers, theses, and computational geotechnical engineering research.
      </p>
    </div>

    <div class="h-[1px] w-full bg-border"></div>

    <div class="grid gap-4">
      {researchPapers.map((paper) => (
        <div class="rounded-lg border border-border bg-card p-6 space-y-3 shadow-sm hover:border-foreground/20 transition-colors">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center rounded-md border border-border bg-secondary px-2.5 py-0.5 text-xs font-mono text-secondary-foreground">
              {paper.data.category || 'Paper'}
            </span>
            {paper.data.year && <span class="text-xs font-mono text-muted-foreground">{paper.data.year}</span>}
          </div>

          <div class="space-y-1">
            <h2 class="text-lg font-bold tracking-tight text-card-foreground">
              {paper.data.title}
            </h2>
            <p class="text-sm text-muted-foreground leading-relaxed">{paper.data.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>