---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const researchItems = await getCollection('research');
---

<Layout title="Research | Saeed Babaee">
  <div class="space-y-8 max-w-4xl mx-auto">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-foreground">Research & Publications</h1>
      <p class="text-muted-foreground mt-2">Academic articles, preprints, and computational geomechanics research.</p>
    </div>

    {researchItems.length === 0 ? (
      <div class="rounded-lg border border-border p-8 text-center text-muted-foreground">
        No research items found.
      </div>
    ) : (
      <div class="space-y-4">
        {researchItems.map((item) => (
          <div class="rounded-lg border border-border bg-card p-6 shadow-sm">
            <div class="flex items-center justify-between text-xs font-mono text-muted-foreground mb-2">
              <span>{item.data.journal || 'Research Note'}</span>
              <span>{item.data.date}</span>
            </div>
            <h2 class="text-xl font-bold text-card-foreground">{item.data.title}</h2>
            <p class="text-sm text-muted-foreground mt-2">{item.data.description}</p>
            {item.data.link && (
              <a href={item.data.link} target="_blank" class="inline-block mt-4 text-xs font-mono text-primary hover:underline">
                Read Publication →
              </a>
            )}
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>