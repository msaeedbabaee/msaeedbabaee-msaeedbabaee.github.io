---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const researchList = await getCollection('research');
---

<Layout title="پژوهش‌ها | پرتفولیو" description="مقالات و فعالیت‌های پژوهشی">
  <div class="container mx-auto max-w-screen-xl px-4 py-10 md:py-16 space-y-8">
    <!-- Header -->
    <div class="flex flex-col items-start gap-2 border-b border-border/40 pb-8">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">پژوهش‌ها و مقالات</h1>
      <p class="text-muted-foreground text-lg">
        فعالیت‌های علمی، مدلسازی‌های محاسباتی و پژوهش‌های انجام‌شده.
      </p>
    </div>

    <!-- Research Cards -->
    <div class="grid gap-6 md:grid-cols-2">
      {researchList.map((item) => (
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm transition-all hover:shadow-md flex flex-col justify-between p-6 space-y-4">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="inline-flex items-center rounded-md bg-secondary px-2.5 py-0.5 text-xs font-semibold text-secondary-foreground">
                پژوهش علمی
              </span>
            </div>
            <h2 class="text-xl font-bold tracking-tight">{item.data.title}</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
              {item.data.description}
            </p>
          </div>

          <div class="pt-4 border-t border-border/40 flex items-center justify-between text-xs text-muted-foreground">
            <span>بررسی علمی و فنی</span>
            <a href="#" class="inline-flex items-center justify-center rounded-md text-xs font-medium transition-colors hover:bg-accent hover:text-accent-foreground h-8 px-3 text-primary">
              مطالعه مقاله ←
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>