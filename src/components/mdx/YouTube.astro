---
// کامپوننت درج ویدیوی یوتیوب داخل محتوای MDX
// در پنل Keystatic فقط کافیه ویدیو آی‌دی رو وارد کنید
interface Props {
  id: string;
  title?: string;
}
const { id, title = 'YouTube video' } = Astro.props;
---
<div class="not-prose my-6 aspect-video w-full overflow-hidden rounded-lg border border-border shadow-sm">
  <iframe
    class="h-full w-full"
    src={`https://www.youtube-nocookie.com/embed/${id}`}
    title={title}
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
  ></iframe>
</div>
